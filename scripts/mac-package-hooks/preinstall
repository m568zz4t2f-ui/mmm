#!/bin/sh
# Installer runs as root. Refuse shadow copies before changing any installation.
set -eu
[ "${3:-/}" = / ] || { echo 'Wolf Tide supports installation on the startup volume only.' >&2; exit 1; }
conflicts=0
for home in /Users/*; do
 for relative in 'Library/Audio/Plug-Ins/Components/Wolf Tide.component' 'Library/Audio/Plug-Ins/VST3/Wolf Tide.vst3' 'Applications/Wolf Audio/Wolf Tide.app'; do
  bundle="$home/$relative"
  if [ -e "$bundle" ] || [ -L "$bundle" ]; then
   version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$bundle/Contents/Info.plist" 2>/dev/null || echo unknown)
   echo "CONFLICT: $bundle (version $version)" >&2
   conflicts=1
  fi
 done
done
if [ "$conflicts" = 1 ]; then
 echo 'Installation stopped before replacement. Run the supplied mac_install.py --scope system --user-home <home> with sudo to verify/back up both locations, retire user shadows, and validate AU registration. Existing files are unchanged.' >&2
 exit 1
fi
lock=/var/tmp/audio.wolf.tide-install.lock
(umask 077; /bin/mkdir "$lock") || { echo "Another installation or incomplete transaction exists: $lock. Inspect its backup before retrying." >&2; exit 1; }
trap '/bin/rm -f "$lock/backup"; /bin/rmdir "$lock" 2>/dev/null || true' 0
trap 'exit 1' 1 2 15
base='/Library/Application Support/Wolf Audio/Wolf Tide/install-backups'
/bin/mkdir -p "$base"
backup=$(/usr/bin/mktemp -d "$base/package-$(date +%Y%m%d-%H%M%S).XXXXXX")
/bin/chmod 700 "$backup"
printf '%s\n' "$backup" > "$lock/backup"
index=0
for bundle in '/Library/Audio/Plug-Ins/Components/Wolf Tide.component' '/Library/Audio/Plug-Ins/VST3/Wolf Tide.vst3' '/Applications/Wolf Audio/Wolf Tide.app'; do
 record="$backup/$index"; /bin/mkdir "$record"; printf '%s\n' "$bundle" > "$record/path"
 if [ -e "$bundle" ] || [ -L "$bundle" ]; then
  [ ! -L "$bundle" ] || { echo "Refusing symlink: $bundle" >&2; exit 1; }
  identity=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$bundle/Contents/Info.plist")
  case "$identity" in audio.wolf.tide|audio.wolf.tide.*) ;; *) echo "Unexpected identity at $bundle" >&2; exit 1;; esac
  /usr/bin/ditto --rsrc --extattr "$bundle" "$record/bundle"
  /usr/bin/diff -qr "$bundle" "$record/bundle" >/dev/null
 fi
 index=$((index+1))
done
printf '%s\n' backed-up > "$backup/status"
# Keep the lock/journal for postinstall and crash recovery.
trap - 0 1 2 15
